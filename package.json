{
	"name": "www",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cf dev",
		"build": "cf build",
		"preview": "$npm_execpath run build && vite preview",
		"cf-typegen": "cf workers types",
		"typecheck": "cf workers types && tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write --unsafe"
	},
	"dependencies": {
		"@cloudensis/design-system": "^0.14.3",
		"hono": "5.0.0-rc.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "2.0.0-beta.v.3",
		"@hono/vite-ssg": "^0.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"cf": "1.0.0-beta.19",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vite-ssr-components": "^0.8.0"
	},
	"overrides": {
		"@cloudensis/design-system": {
			"hono": "$hono"
		},
		"@hono/vite-ssg": {
			"hono": "$hono"
		}
	},
	"imports": {
		"#/*": [
			"./*.ts",
			"./*.tsx",
			"./*"
		]
	}
}
