{
	"name": "www",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "$npm_execpath run build && vite preview",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars false",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write --unsafe",
		"test": "vitest run"
	},
	"dependencies": {
		"@cloudensis/design-system": "^0.14.1",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vite-ssr-components": "^0.8.0",
		"vitest": "^5.0.3",
		"wrangler": "^4.148.0"
	},
	"imports": {
		"#/*": [
			"./*.ts",
			"./*.tsx",
			"./*"
		]
	}
}
