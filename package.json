{
	"name": "www",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cf dev",
		"build": "cf build",
		"preview": "$npm_execpath run build && vite preview",
		"cf-typegen": "cf workers types",
		"typecheck": "cf workers types && tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write --unsafe",
		"test": "vitest run"
	},
	"dependencies": {
		"@cloudensis/design-system": "^0.14.3",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "2.0.0-beta.v.2",
		"@tailwindcss/vite": "^4.3.3",
		"cf": "1.0.0-beta.18",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vite-ssr-components": "^0.8.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#/*": [
			"./*.ts",
			"./*.tsx",
			"./*"
		]
	}
}
