{
	"name": "www",
	"type": "module",
	"scripts": {
		"dev:fe": "tsx watch src/frontend/build.ts",
		"dev:be": "wrangler dev",
		"build:fe": "tsx src/build.ts",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"lint": "biome check",
		"format": "biome check --write --unsafe"
	},
	"dependencies": {
		"hono": "^4.12.25"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"wrangler": "^4.100.0"
	},
	"overrides": {
		"esbuild": "^0.28.1"
	},
	"imports": {
		"#/*": [
			"./src/*.ts",
			"./src/*.tsx",
			"./src/*"
		]
	}
}
