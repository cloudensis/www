{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudensis",
	"compatibility_date": "2025-08-03",
	"main": "./src/index.tsx",
	"send_email": [{ "name": "EMAIL" }],
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAAE74sVfBuWWTb_at"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	}
}
