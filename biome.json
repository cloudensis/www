{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"useJsxKeyInIterable": "on"
			},
			"nursery": {
				"useSortedClasses": {
					"level": "on",
					"options": {
						"functions": ["cn"]
					}
				}
			}
		}
	},
	"assist": {
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!.claude",
			"!.wrangler",
			"!dist",
			"!node_modules",
			"!worker-configuration.d.ts"
		]
	}
}
