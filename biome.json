{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true
	},
	"assist": {
		"enabled": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!node_modules",
			"!dist",
			"!.wrangler",
			"!worker-configuration.d.ts"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
